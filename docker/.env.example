# Docker Compose Environment Configuration
# Copy this file to .env and adjust values as needed

# Application versions (from DockerHub)
BACK_VERSION=latest-snapshot
FRONT_VERSION=latest-snapshot

# Spring profile (dev/prod)
SPRING_PROFILE=dev

# Port configuration
BACK_PORT=8081
FRONT_PORT=1080
MYSQL_PORT=3306

# MySQL configuration
# These are provided by Jenkins credentials (mysql-credentials) in CI
# For local development, set your own values
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=adeuxpas
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# JWT Secret (provided by Jenkins credentials jwt-secret in CI)
JWT_SECRET=your_jwt_secret_key_here
