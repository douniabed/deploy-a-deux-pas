# ==============================================================================
# Docker Compose Environment Variables
# ==============================================================================
# Copy this file to .env for local development: cp .env.example .env
# In Jenkins CI/CD, these are provided by Jenkins credentials (no .env needed).

# ==============================================================================
# APPLICATION VERSIONS (from DockerHub)
# ==============================================================================
BACK_VERSION=latest
FRONT_VERSION=latest

# ==============================================================================
# SPRING PROFILE
# ==============================================================================
SPRING_PROFILE=docker

# ==============================================================================
# PORT CONFIGURATION
# ==============================================================================
BACK_PORT=8081
FRONT_PORT=1080
MYSQL_PORT=3306

# ==============================================================================
# MYSQL CONFIGURATION
# ==============================================================================
MYSQL_DATABASE=adeuxpas-db

# Jenkins credential: mysql-credentials
# Jenkins provides: MYSQL_CREDENTIALS_USR, MYSQL_CREDENTIALS_PSW
MYSQL_CREDENTIALS_USR=your-mysql-user
MYSQL_CREDENTIALS_PSW=your-mysql-password

# ==============================================================================
# SECRETS
# ==============================================================================
# In Jenkins, these are set by credentials block in Jenkinsfile.
# For local dev, fill in your own values.

# Jenkins credential: jwt-secret
JWT_SECRET=your-jwt-secret-base64

# Jenkins credential: cloudinary-api-key
CLOUDINARY_API_KEY=your-cloudinary-api-key

# Jenkins credential: cloudinary-api-secret
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Jenkins credential: stripe-api-key
STRIPE_API_KEY=sk_test_your-stripe-key

# Jenkins credential: stripe-webhook-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Jenkins credential: mapbox-token
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token
